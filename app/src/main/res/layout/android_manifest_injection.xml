<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_background"
    android:orientation="vertical"
    tools:ignore="ContentDescription">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chat_background"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_chat_toolbar"
            app:menu="@menu/manifest_manager_menu"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/chat_text_primary"
            app:subtitleTextColor="@color/chat_text_secondary"
            app:title="@string/manifest_manager_title"
            app:titleTextColor="@color/chat_text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Where the final AndroidManifest.xml comes from -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/chat_surface"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/chat_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/manifest_manager_source_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/chat_text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/manifest_manager_source_description"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/chat_text_secondary" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/mode_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mode_generated"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/manifest_manager_mode_generated"
                            app:icon="@drawable/ic_mtrl_settings_applications" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/mode_custom"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/manifest_manager_mode_custom"
                            app:icon="@drawable/ic_mtrl_code" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_store_icon_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/status_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_mtrl_info"
                            app:tint="@color/chat_accent" />

                        <TextView
                            android:id="@+id/status_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/chat_text_primary"
                            tools:text="Built from the project and the options below" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/status_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorSize="18dp"
                            app:trackThickness="2dp" />
                    </LinearLayout>

                    <!-- Custom XML: preview and actions -->
                    <LinearLayout
                        android:id="@+id/custom_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_store_icon_card"
                            android:scrollbars="none">

                            <TextView
                                android:id="@+id/custom_preview"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:padding="12dp"
                                android:textColor="@color/chat_text_primary"
                                android:textSize="11sp"
                                tools:text="&lt;manifest ...&gt;" />
                        </HorizontalScrollView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/action_edit_custom"
                                style="@style/Widget.Material3.Button.IconButton.Filled"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/manifest_manager_action_edit"
                                android:tooltipText="@string/manifest_manager_action_edit"
                                app:icon="@drawable/ic_mtrl_edit" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/action_load_generated"
                                style="@style/Widget.Material3.Button.IconButton.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:contentDescription="@string/manifest_manager_action_load_generated"
                                android:tooltipText="@string/manifest_manager_action_load_generated"
                                app:icon="@drawable/ic_mtrl_refresh" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/action_validate"
                                style="@style/Widget.Material3.Button.IconButton.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:contentDescription="@string/manifest_manager_action_validate"
                                android:tooltipText="@string/manifest_manager_action_validate"
                                app:icon="@drawable/ic_mtrl_shield_check" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/action_discard_custom"
                                style="@style/Widget.Material3.Button.IconButton.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:contentDescription="@string/manifest_manager_action_discard"
                                android:tooltipText="@string/manifest_manager_action_discard"
                                app:icon="@drawable/ic_p2p_delete" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Options used when the manifest is generated -->
            <TextView
                android:id="@+id/generated_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/manifest_manager_generated_header"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/chat_accent" />

            <TextView
                android:id="@+id/generated_ignored_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/manifest_manager_generated_ignored"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/chat_text_secondary"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/options_card"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/chat_surface"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/chat_border">

                <LinearLayout
                    android:id="@+id/options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/manifest_manager_activities_header"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/chat_accent" />

                <ImageButton
                    android:id="@+id/add_activity"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/common_word_add_activtiy"
                    android:src="@drawable/ic_mtrl_add"
                    android:tooltipText="@string/common_word_add_activtiy"
                    app:tint="@color/chat_text_primary" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/chat_surface"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/chat_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/activities_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/activities_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="@string/manifest_manager_activities_empty"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/chat_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
