<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_surface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fadingEdgeLength="30dp"
        android:requiresFadingEdge="vertical"
        android:transitionGroup="true">

        <LinearLayout
            android:id="@+id/store_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/chat_surface"
            android:orientation="vertical"
            android:paddingBottom="96dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/chat_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/chat_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_store_icon_card"
                        android:padding="8dp"
                        app:srcCompat="@drawable/sketch_app_icon" />

                    <TextView
                        android:id="@+id/storeSideNote"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:maxLines="3"
                        android:text="@string/store_side_note"
                        android:textColor="@color/chat_text_primary"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/open_store_button"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_store_primary_button"
                        android:minWidth="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="@string/store_open_website"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/stat_apks"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_store_outline_pill"
                    android:gravity="center"
                    android:textColor="@color/chat_text_primary"
                    android:textSize="12sp"
                    tools:text="2\nAPKs" />

                <TextView
                    android:id="@+id/stat_swbs"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_store_outline_pill"
                    android:gravity="center"
                    android:textColor="@color/chat_text_primary"
                    android:textSize="12sp"
                    tools:text="1\nSWBs" />

                <TextView
                    android:id="@+id/stat_users"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_store_outline_pill"
                    android:gravity="center"
                    android:textColor="@color/chat_text_primary"
                    android:textSize="12sp"
                    tools:text="6\nUsers" />

                <TextView
                    android:id="@+id/stat_downloads"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_store_outline_pill"
                    android:gravity="center"
                    android:textColor="@color/chat_text_primary"
                    android:textSize="12sp"
                    tools:text="5\nDownloads" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/store_suggestions_title"
                    android:textColor="@color/chat_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    app:srcCompat="@drawable/ic_mtrl_more_vertical"
                    app:tint="@color/chat_text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/result_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:text="@string/store_loading"
                android:textColor="@color/chat_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/shimmer_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <include layout="@layout/view_store_project_skeleton" />

                <include layout="@layout/view_store_project_skeleton" />

                <include layout="@layout/view_store_project_skeleton" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/publications_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingTop="8dp"
                tools:itemCount="6"
                tools:listitem="@layout/view_store_project_item" />

            <TextView
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/store_empty"
                android:textColor="@color/chat_text_secondary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/load_more_button"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:text="@string/store_load_more"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/filter_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="104dp"
        android:text="@string/store_filters_title"
        app:icon="@drawable/ic_mtrl_tune" />
</FrameLayout>
