<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_background"
    android:clipToPadding="false"
    android:fadingEdgeLength="30dp"
    android:requiresFadingEdge="vertical"
    android:transitionGroup="true">

    <LinearLayout
        android:id="@+id/store_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chat_background"
        android:orientation="vertical"
        android:paddingBottom="96dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/chat_surface"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/chat_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/storeSideNote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="8dp"
                    android:maxLines="3"
                    android:text="@string/store_side_note"
                    android:textColor="@color/chat_text_secondary"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/ic_mtrl_info"
                    app:drawableTint="@color/chat_accent" />

                <Button
                    android:id="@+id/open_store_button"
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/store_open_website"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/stats_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stat_apks"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_thread_item"
                android:gravity="center"
                android:textColor="@color/chat_text_primary"
                android:textSize="13sp"
                tools:text="2\nAPKs" />

            <TextView
                android:id="@+id/stat_swbs"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_thread_item"
                android:gravity="center"
                android:textColor="@color/chat_text_primary"
                android:textSize="13sp"
                tools:text="1\nSWBs" />

            <TextView
                android:id="@+id/stat_users"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_thread_item"
                android:gravity="center"
                android:textColor="@color/chat_text_primary"
                android:textSize="13sp"
                tools:text="6\nUsers" />

            <TextView
                android:id="@+id/stat_downloads"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_thread_item"
                android:gravity="center"
                android:textColor="@color/chat_text_primary"
                android:textSize="13sp"
                tools:text="5\nDownloads" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/chat_surface"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/chat_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_mtrl_search"
                    app:tint="@color/chat_text_secondary" />

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/store_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/chat_text_primary"
                    android:textColorHint="@color/chat_text_hint"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="16dp"
            android:text="@string/store_filter_type"
            android:textColor="@color/chat_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/kind_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:text="@string/store_filter_sort"
            android:textColor="@color/chat_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sort_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:text="@string/store_filter_flags"
            android:textColor="@color/chat_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filter_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/free_chip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/store_filter_free" />

            <com.google.android.material.chip.Chip
                android:id="@+id/open_source_chip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/store_filter_open_source" />

            <com.google.android.material.chip.Chip
                android:id="@+id/featured_chip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/store_filter_featured" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:text="@string/store_filter_category"
            android:textColor="@color/chat_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/category_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            app:singleLine="false"
            app:singleSelection="true"
            app:selectionRequired="true" />

        <TextView
            android:id="@+id/result_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="16dp"
            android:text="@string/store_loading"
            android:textColor="@color/chat_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/shimmer_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_thread_item"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="70dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="18dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_thread_item"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="70dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="18dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_thread_item"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="70dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="18dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_thread_item"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="70dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="18dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_thread_item"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="70dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="18dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_thread_item"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="70dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="18dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_thread_item"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="70dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="18dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_thread_item"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="70dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="18dp"
                        android:background="@color/chat_surface_soft" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/chat_surface_soft" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/publications_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            tools:itemCount="12"
            tools:listitem="@layout/view_store_project_item" />

        <TextView
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/store_empty"
            android:textColor="@color/chat_text_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/load_more_button"
            style="@style/Widget.Material3Expressive.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="8dp"
            android:text="@string/store_load_more"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
