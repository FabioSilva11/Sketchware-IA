<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/model_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/chat_text_primary"
        android:textSize="13sp"
        tools:text="gpt-4o-mini" />

    <ImageButton
        android:id="@+id/btn_delete_model"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/ia_delete_model"
        android:padding="6dp"
        android:src="@drawable/ic_mtrl_close"
        app:tint="@color/chat_text_secondary" />

</LinearLayout>
