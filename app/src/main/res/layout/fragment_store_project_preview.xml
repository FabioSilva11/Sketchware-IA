<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fadingEdgeLength="120dp"
        android:requiresFadingEdge="vertical">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/chat_background"
            android:orientation="vertical"
            android:paddingTop="72dp"
            android:paddingBottom="112dp">

            <LinearLayout
                android:id="@+id/hero_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_store_detail_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/icon"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/bg_store_icon_card"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Large"
                    app:srcCompat="@drawable/default_icon"
                    app:strokeColor="@color/chat_border"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/kind_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_store_outline_pill"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:textColor="@color/chat_accent"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="SWB" />

                        <TextView
                            android:id="@+id/category_badge"
                            android:layout_width="0dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_store_primary_button"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:singleLine="true"
                            android:paddingHorizontal="10dp"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="Ferramentas" />

                        <TextView
                            android:id="@+id/free_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_store_outline_pill"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:textColor="@color/chat_text_primary"
                            android:textSize="11sp"
                            tools:text="R$ 200.00" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="3"
                        android:textColor="@color/chat_text_primary"
                        android:textSize="27sp"
                        android:textStyle="bold"
                        app:lineHeight="32dp"
                        tools:text="MLBB WINRATE CALCULATOR" />

                    <TextView
                        android:id="@+id/author"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/store_play_blue"
                        android:textSize="14sp"
                        tools:text="by Xoni" />

                    <TextView
                        android:id="@+id/header_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/chat_text_secondary"
                        android:textSize="13sp"
                        tools:text="Ferramentas - SWB" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <RatingBar
                            android:id="@+id/rating_bar"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:isIndicator="true"
                            android:numStars="5"
                            android:rating="0"
                            android:stepSize="0.5" />

                        <TextView
                            android:id="@+id/detail_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/chat_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="0.0" />

                        <TextView
                            android:id="@+id/detail_comments"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/chat_text_secondary"
                            android:textSize="12sp"
                            tools:text="(0)" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="14dp"
                            app:srcCompat="@drawable/ic_mtrl_download"
                            app:tint="@color/chat_text_secondary" />

                        <TextView
                            android:id="@+id/downloads"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:textColor="@color/chat_text_secondary"
                            android:textSize="12sp"
                            tools:text="0" />

                        <TextView
                            android:id="@+id/likes_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:textColor="@color/chat_text_secondary"
                            android:textSize="12sp"
                            tools:text="0 likes" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/buttons_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="start"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_download"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="118dp"
                            android:paddingHorizontal="16dp"
                            android:text="@string/store_preview_download"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/chat_accent"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/ic_mtrl_download"
                            app:iconGravity="textStart"
                            app:iconTint="@android:color/white" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_what_is_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/chat_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/chat_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/store_whats_new"
                        android:textColor="@color/chat_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/what_is_new"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/chat_text_secondary"
                        android:textIsSelectable="true"
                        android:textSize="14sp"
                        tools:text="New version with improvements and fixes." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/screenshots_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="26dp"
                android:paddingBottom="12dp"
                android:text="@string/publish_images_title_screenshots"
                android:textColor="@color/chat_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/screenshots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="4"
                tools:listitem="@layout/view_store_project_screenshot" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="26dp"
                android:paddingBottom="10dp"
                android:text="@string/store_details_section"
                android:textColor="@color/chat_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/details_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="@color/chat_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/chat_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Version"
                            android:textColor="@color/chat_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/detail_version"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/chat_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="1.0.0" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Price"
                            android:textColor="@color/chat_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/detail_price"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/chat_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="R$ 200.00" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Size"
                            android:textColor="@color/chat_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/filesize"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/chat_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="18 KB" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Published"
                            android:textColor="@color/chat_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/detail_published"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/chat_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Jul 02, 2026" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Updated"
                            android:textColor="@color/chat_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/timestamp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/chat_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Jul 02, 2026" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="License"
                            android:textColor="@color/chat_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/detail_license"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/chat_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="MIT" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Category"
                            android:textColor="@color/chat_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/detail_category"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/chat_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Tools" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Language"
                            android:textColor="@color/chat_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/detail_language"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/chat_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Mm" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/chips_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:theme="@style/ThemeOverlay.SketchwarePro.Chip.ProjectPreview" />

                    <TextView
                        android:id="@+id/detail_website"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawablePadding="8dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/store_play_blue"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/ic_mtrl_web"
                        app:drawableTint="@color/store_play_blue"
                        tools:text="Website" />

                    <TextView
                        android:id="@+id/detail_video"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawablePadding="8dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/store_play_blue"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/ic_mtrl_video"
                        app:drawableTint="@color/store_play_blue"
                        tools:text="Video" />

                    <TextView
                        android:id="@+id/detail_github"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawablePadding="8dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/store_play_blue"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/ic_mtrl_link"
                        app:drawableTint="@color/store_play_blue"
                        tools:text="GitHub" />

                    <TextView
                        android:id="@+id/detail_privacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawablePadding="8dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/store_play_blue"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/ic_mtrl_info"
                        app:drawableTint="@color/store_play_blue"
                        tools:text="Privacy policy" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/developer_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/chat_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/chat_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/developer_avatar"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                        app:srcCompat="@drawable/ic_mtrl_profile" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/detail_developer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/chat_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Xoni is a dev" />

                        <TextView
                            android:id="@+id/developer_username"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/chat_text_secondary"
                            android:textSize="12sp"
                            tools:text="@xoni_" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="26dp"
                android:paddingBottom="8dp"
                android:text="@string/store_about_this_app"
                android:textColor="@color/chat_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:textColor="@color/chat_text_primary"
                android:textIsSelectable="true"
                android:textSize="15sp"
                app:lineHeight="22dp"
                tools:text="Your AI assistant for writing, research, image generation, and more." />

            <TextView
                android:id="@+id/version_history_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="28dp"
                android:paddingBottom="12dp"
                android:text="Version history"
                android:textColor="@color/chat_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/versions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="28dp"
                android:paddingBottom="8dp"
                android:text="Reviews"
                android:textColor="@color/chat_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/rating_summary_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="@color/chat_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/chat_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/rating_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/chat_text_secondary"
                        android:textSize="13sp"
                        tools:text="0.0 out of 5 - 0 reviews" />

                    <RatingBar
                        android:id="@+id/detail_rating_bar"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:isIndicator="true"
                        android:numStars="5"
                        android:rating="0"
                        android:stepSize="0.5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/reviews_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="10dp"
                android:text="No public reviews yet."
                android:textColor="@color/chat_text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/reviews_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingTop="10dp"
                tools:itemCount="2"
                tools:listitem="@layout/view_store_project_review_item" />

            <TextView
                android:id="@+id/comments_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="28dp"
                android:paddingBottom="6dp"
                android:text="Comments"
                android:textColor="@color/chat_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/comments_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="No public comments yet."
                android:textColor="@color/chat_text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/comments_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingTop="6dp"
                tools:itemCount="2"
                tools:listitem="@layout/view_store_project_preview_comment" />

            <TextView
                android:id="@+id/more_from_developer_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="28dp"
                android:paddingBottom="12dp"
                android:text="@string/store_more_from_developer"
                android:textColor="@color/chat_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/more_from_developer_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="16dp"
                android:visibility="gone"
                tools:itemCount="4"
                tools:listitem="@layout/view_store_project_recommendation_item"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/top_scrim"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:alpha="0"
        android:background="@color/chat_surface" />

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="?attr/actionBarSize"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="centerInside"
            app:srcCompat="?attr/homeAsUpIndicator"
            app:tint="@color/chat_text_primary" />

        <LinearLayout
            android:id="@+id/toolbar_title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="invisible"
            tools:visibility="visible">

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:textColor="@color/chat_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="ChatGPT" />

            <TextView
                android:id="@+id/toolbar_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/chat_text_secondary"
                android:textSize="12sp"
                tools:text="OpenAI" />
        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btn_open_in"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_mtrl_more_vertical"
            app:tint="@color/chat_text_primary" />
    </LinearLayout>
</FrameLayout>
