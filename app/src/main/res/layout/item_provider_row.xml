<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <!-- Provider icon -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/provider_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="14dp"
        android:background="@color/chat_surface_soft"
        android:padding="7dp"
        android:scaleType="centerInside"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        tools:src="@drawable/ic_github" />

    <!-- Name -->
    <TextView
        android:id="@+id/provider_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/chat_text_primary"
        android:textSize="16sp"
        tools:text="OpenAI" />

    <!-- ON / OFF badge -->
    <TextView
        android:id="@+id/provider_status_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_provider_status_badge"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:minWidth="44dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textSize="12sp"
        tools:text="ON"
        tools:textColor="@color/provider_status_on_text" />

    <!-- Chevron -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_mtrl_chevron_right_24"
        android:tint="@color/chat_text_secondary" />

</LinearLayout>
