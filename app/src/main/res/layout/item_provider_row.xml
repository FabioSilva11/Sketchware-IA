<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="14dp"
        app:cardBackgroundColor="@color/chat_surface_soft"
        app:cardCornerRadius="17dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/chat_divider"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/provider_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="centerInside"
                tools:src="@drawable/kelivo_icon_openai" />

            <TextView
                android:id="@+id/provider_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/chat_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="K" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_provider_row_divider"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/provider_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/chat_text_primary"
            android:textSize="15sp"
            tools:text="OpenAI" />

        <TextView
            android:id="@+id/provider_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_provider_status_badge"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="10dp"
            android:textAllCaps="true"
            android:textSize="12sp"
            tools:text="OFF" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_mtrl_chevron_right_24"
            app:tint="@color/chat_text_primary" />
    </LinearLayout>
</LinearLayout>
