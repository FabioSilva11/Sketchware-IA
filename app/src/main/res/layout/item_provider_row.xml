<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_kelivo_avatar">

          <ImageView
            android:id="@+id/provider_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@drawable/kelivo_icon_openai" />
        </FrameLayout>

        <TextView
            android:id="@+id/provider_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/chat_text_primary"
            android:textSize="16sp"
            tools:text="OpenAI" />

        <TextView
            android:id="@+id/provider_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_provider_status_badge"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="38dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textSize="11sp"
            tools:text="ON"
            tools:textColor="@color/provider_status_on_text" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_mtrl_chevron_right_24"
            android:tint="@color/chat_text_primary" />
    </LinearLayout>

    <View
        android:id="@+id/row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="50dp"
        android:background="@color/chat_divider" />
</LinearLayout>
